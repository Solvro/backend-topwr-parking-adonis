{
  "name": "parking-api",
  "version": "1.0.0",
  "private": true,
  "license": "AGPL-3.0",
  "type": "module",
  "imports": {
    "#controllers/*": "./app/controllers/*.js",
    "#exceptions/*": "./app/exceptions/*.js",
    "#models/*": "./app/models/*.js",
    "#mails/*": "./app/mails/*.js",
    "#services/*": "./app/services/*.js",
    "#listeners/*": "./app/listeners/*.js",
    "#events/*": "./app/events/*.js",
    "#middleware/*": "./app/middleware/*.js",
    "#validators/*": "./app/validators/*.js",
    "#providers/*": "./providers/*.js",
    "#policies/*": "./app/policies/*.js",
    "#abilities/*": "./app/abilities/*.js",
    "#database/*": "./database/*.js",
    "#start/*": "./start/*.js",
    "#tests/*": "./tests/*.js",
    "#config/*": "./config/*.js",
    "#helpers/*": "./app/helpers/*.js",
    "#generated/*": "./.adonisjs/server/*.js",
    "#transformers/*": "./app/transformers/*.js"
  },
  "scripts": {
    "build": "node ace build",
    "dev": "node ace serve --hmr",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "prepare": "husky || true",
    "start": "node bin/server.js",
    "test": "node ace test",
    "typecheck": "tsc --noEmit"
  },
  "lint-staged": {
    "*": "prettier -w --ignore-unknown"
  },
  "prettier": "@solvro/config/prettier",
  "resolutions": {
    "strtok3": "8.0.1"
  },
  "overrides": {
    "@typescript-eslint/eslint-plugin": "8.70.1",
    "@typescript-eslint/parser": "8.70.1",
    "@typescript-eslint/project-service": "8.70.1",
    "@typescript-eslint/scope-manager": "8.70.1",
    "@typescript-eslint/tsconfig-utils": "8.70.1",
    "@typescript-eslint/type-utils": "8.70.1",
    "@typescript-eslint/types": "8.70.1",
    "@typescript-eslint/typescript-estree": "8.70.1",
    "@typescript-eslint/utils": "8.70.1",
    "@typescript-eslint/visitor-keys": "8.70.1",
    "typescript-eslint": "8.70.1"
  },
  "dependencies": {
    "@adonisjs/auth": "^10.1.0",
    "@adonisjs/core": "^7.6.0",
    "@adonisjs/cors": "^3.0.0",
    "@adonisjs/lucid": "^22.4.2",
    "@adonisjs/static": "^2.0.1",
    "@solvro/error-handling": "^1.1.0",
    "@solvro/utils": "^1.5.0",
    "@tuyau/core": "^1.3.0",
    "@vinejs/vine": "^4.4.0",
    "adonisjs-scheduler": "^2.0.0",
    "luxon": "^3.5.0",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "@adonisjs/assembler": "^8.6.0",
    "@adonisjs/eslint-config": "^3.1.0",
    "@adonisjs/prettier-config": "^1.5.0",
    "@adonisjs/tsconfig": "^2.0.0",
    "@commitlint/cli": "^19.6.1",
    "@japa/api-client": "^3.2.1",
    "@japa/assert": "^4.2.0",
    "@japa/plugin-adonisjs": "^5.2.0",
    "@japa/runner": "^5.4.0",
    "@poppinss/ts-exec": "^1.5.2",
    "@solvro/config": "^4.0.0",
    "@types/luxon": "^3.4.2",
    "@types/node": "^22.10.2",
    "eslint": "^10.15.0",
    "hot-hook": "^0.4.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.4.3",
    "pino-pretty": "^13.0.0",
    "prettier": "^3.4.2",
    "typescript": "~5.7",
    "youch": "^4.1.1"
  },
  "hotHook": {
    "boundaries": [
      "./app/controllers/**/*.ts",
      "./app/middleware/*.ts"
    ]
  },
  "patchedDependencies": {
    "jsonschema@1.5.0": "patches/jsonschema@1.5.0.patch"
  }
}
